# ==============================================================================
# MOBIRA - Environment Configuration Template
# ==============================================================================
# NOTE: Never commit production credentials. Copy this file to .env or .env.local

# General
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=django-insecure-mobira-fintech-prototype-competition-key-2026

# Database (PostgreSQL required from day one)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mobira_db
POSTGRES_DB=mobira_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# CORS & Frontend Origins
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Next.js Public Config
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=Mobira
NEXT_PUBLIC_ENVIRONMENT=prototype
NEXT_PUBLIC_SIMULATION_MODE=true

# Mock Provider Settings
MOCK_PROVIDER_LATENCY_MS=600
MOCK_SIMULATE_RANDOM_FAILURES=false
MAKER_CHECKER_THRESHOLD_XAF=500000
