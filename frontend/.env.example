# ==============================================================================
# Mobira Frontend Environment Variables (Vercel / Local)
# ==============================================================================

# URL of the deployed Django backend REST API (e.g. on Render, Railway, Fly.io)
# Note: If running locally, use http://localhost:8080/api or http://127.0.0.1:8080/api
NEXT_PUBLIC_API_URL=https://your-backend-api.onrender.com/api

# Optional: Set environment mode
NODE_ENV=production
