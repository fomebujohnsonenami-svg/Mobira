# Django Backend Environment Template
DEBUG=True
SECRET_KEY=django-insecure-mobira-fintech-backend-prototype-2026

# Database: Strictly PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mobira_db

ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rails simulation controls
MOCK_PROVIDER_LATENCY_MS=500
MAKER_CHECKER_THRESHOLD_XAF=500000
