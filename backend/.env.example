# ==============================================================================
# Mobira Backend Environment Variables (Render / Railway / Production)
# ==============================================================================

# 1. PostgreSQL Database URL (e.g. from Neon.tech, Supabase, Render, or Railway)
DATABASE_URL=postgresql://user:password@ep-xyz-12345.us-east-2.aws.neon.tech/mobira_db?sslmode=require

# 2. Django Security & Debug
SECRET_KEY=django-insecure-mobira-fintech-prod-secret-key-2026
DEBUG=False

# 3. Allowed Hosts (Comma-separated hostnames/domains for the backend)
ALLOWED_HOSTS=your-backend-api.onrender.com,localhost,127.0.0.1

# 4. CORS Allowed Origins (Comma-separated frontend URLs allowed to make API requests)
CORS_ALLOWED_ORIGINS=https://your-mobira-frontend.vercel.app,http://localhost:3000

# 5. CSRF Trusted Origins
CSRF_TRUSTED_ORIGINS=https://your-mobira-frontend.vercel.app,https://your-backend-api.onrender.com

# 6. Mobira Business Policy Engine Defaults (Optional)
MAKER_CHECKER_THRESHOLD_XAF=500000
MOCK_PROVIDER_LATENCY_MS=300
